      "description": "Une sonde est comptabilisée \"Up\" si au moins 50% des requêtes effectuées pendant la dernière minute ont réussi.\nInversement, une sonde est comptabilisée \"Down\" si strictement moins de 50% des requêtes effectuées pendant la dernière minute ont échoué.\nCela permet de stabiliser le compteur si une sonde échoue une fois de manière passagère.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "text",
            "mode": "fixed"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Up"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Down"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 7,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "id": 10,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "pluginVersion": "12.3.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prometheus}"
          },
          "editorMode": "code",
          "expr": "count(max by(target) (avg_over_time(probe_success{cluster=~\"$cluster\", namespace=~\"$namespace\", sonde=~\"$sonde\"}[1m])) >= 0.5) OR on() vector(0)",
          "instant": false,
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prometheus}"
          },
          "editorMode": "code",
          "expr": "count(max by(target) (avg_over_time(probe_success{cluster=~\"$cluster\", namespace=~\"$namespace\", sonde=~\"$sonde\"}[1m])) < 0.5) OR on() vector(0)",
          "hide": false,
          "instant": false,
          "legendFormat": "__auto",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "États des sondes Blackbox",
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "(.*>= 0.*)",
            "renamePattern": "Up"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "(.*< 0.*)",
            "renamePattern": "Down"
          }
        }
      ],
      "type": "stat"
    },
